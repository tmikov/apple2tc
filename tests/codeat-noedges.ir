// Loaded binary at [$0300..$0336]
// code labels: 1
// data labels: 0
// Gen    :
// Kill   :
// Mod    : A, X, Y, STATUS_N, STATUS_V, STATUS_B, STATUS_D, STATUS_I, STATUS_NotZ, STATUS_C
// LiveIn :
// LiveOut: A, X, Y, STATUS_N, STATUS_V, STATUS_B, STATUS_D, STATUS_I, STATUS_NotZ, STATUS_C
function func1
%bb1:  // Pred() Succ()
                StoreR8       X, 0x00
                StoreR8       Y, 0x00
                StoreSP       0xff
                StoreR8       STATUS_V, 0x00
                StoreR8       STATUS_B, 0x00
                StoreR8       STATUS_D, 0x00
                StoreR8       STATUS_I, 0x00
                StoreR8       STATUS_C, 0x00
/*$0300*/       AddCycles     12
/*$0302*/       Push8         0x03
/*$0303*/       StoreR8       STATUS_NotZ, 0x1f
                StoreR8       STATUS_N, 0x00
                StoreR8       A, 0x1f
/*$0305*/       Push8         0x1f
/*$0306*/       RTS           0x00
%bb2:  // Pred() Succ()
                Exit
end func1

