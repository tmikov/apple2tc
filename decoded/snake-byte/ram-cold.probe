# Memory equivalence between the cold-start build and the booting one.
#
# ram.probe's counterpart, and deliberately not the same program: it drops the
# stack.
#
# ram.probe compares SP and the live stack because the two *engines* it checks
# are running the same 6502 program and must agree about it byte for byte. The
# cold build is not that. It is on its way to having no emulated stack at all --
# the fake return addresses the adapters push exist only to keep a 6502 shape
# that the conversion is removing -- so comparing the stack here would pin the
# scaffolding rather than the game, and would go red on the first adapter
# deleted rather than on the first bug.
#
# What is left is what actually matters: zero page, the $02xx/$03xx flags, the
# text page, the buffers, and the game's own data at $6000-$BFFF. Those are the
# game's state, and they have to survive every step of the cleanup.
#
# $0000-$0008 and $0020-$003E are skipped. That is the oracle this cleanup has
# spent so far, and the reason is the same for all of it: the storage moved out
# of emulated RAM into C, so the bytes left behind are stale in one build and
# current in the other.
# The plotter's argument block used to live there; it is a C object in the cold
# build now (s_plot), so the bytes it left in RAM are stale in one build and
# current in the other. Nothing is wrong -- the values still exist and still
# drive the same drawing, they are simply no longer at an address a probe can
# reach. Probe phase 3, which would let a probe read a generated program's own
# variables, is what would restore this; it is unbuilt.
#
# What still covers those nine bytes: the screen, at all 6,808 samples. A wrong
# shape, ink, column or row changes pixels, which is exactly the property this
# range had. What is no longer covered is a value that is wrong but never
# drawn.
#
# Do not widen this back without moving the storage back. A hash over $0000
# here would fail on every run and teach whoever sees it to ignore the memory
# check.
#
# $0020-$003E went the same way and for the same reason. That is the monitor's
# own zero page -- the text window, the cursor, the line bases, the lo-res
# colour and mask, the output vector -- and it belonged to the ROM rather than
# to the game. That is not a distinction that survives: the ROM is being
# decompiled too, and there is no version of this artifact in which the monitor
# keeps its state in a 64K array.
#
# The whole span is skipped rather than the twenty-one addresses that actually
# moved. The nine that did not ($2F, $31, $33, $34, $38-$3D) are written by
# neither build, so they hold their entry-state value in both and hashing them
# proves nothing either way.
#
# What still covers this range is the screen, at both sample sites. Nearly all
# of it is drawing state: a wrong cursor, window, line base, colour or mask
# puts the wrong thing in the wrong place, which is the whole of what these
# bytes do.
#
# The rest of zero page is hashed in three pieces, to skip that span and
# $4E/$4F, RNDL and RNDH. The ROM's
# KEYIN increments them while it spins, so their value records how long the
# boot waited for a keystroke -- which makes them differ between two boots of
# the *same* build, never mind between one that boots and one that does not.
# Nothing but KEYIN reads them and the cold build never runs it. Measured: they
# are the only two bytes below $C000 that differ, and they differ in all 6,808
# samples.
#
# The game's own variables are leaving RAM too, and each one that goes takes a
# hole out of the $6000-$BFFF range below. The holes are XORed back into one
# `game` field rather than given a parameter each: a probe takes at most
# sixteen parameters (PROBE_MAX_PARAMS) and there are more holes than that
# coming. XOR is enough for what this checks -- one wrong byte changes exactly
# one sub-hash, and nothing else changes to cancel it.
#
# Each hole is listed above the expression with what moved out of it. Widening
# one back means moving its storage back.
#
# Sampled at $6217 like the others, which is in-game only, so there is no boot
# prefix to align away.
counter n

probe kb() {
  inc n
  key n
}

probe mem(
    zp_a = hash($0009, $001F),
    zp_b = hash($003F, $004D),
    zp_hi = hash($0050, $00FF),
    low = hash($0200, $03FF),
    txt = hash($0400, $07FF),
    aux = hash($0800, $1FFF),
    hgr = hash($2000, $5FFF),
    # $623C-$6255  the key ring, the snake's head and tail, growth, the life
    #              timer and how the life ended. The two delta tables below
    #              them ($6232-$623B) are read-only and stay hashed.
    # $6473        s_click_count
    # $6633-$6640  the bouncer parameter block, the step's discarded residue
    #              ($6637/$6638) and the two bouncers themselves
    # $69C2        s_sound_muted
    # $6B38-$6B3C  s_steer_dir, s_apple, and the sweep cursor it discarded
    # $6C46-$6C4A  the tone, the click port, and $6C4A's discarded residue
    # $6C71        s_joystick_selected
    # $71CB-$71CC  s_apple_value
    # $7252-$7266  the scoreboard: score, high score, apples, lives, level
    # $78B0-$78B2  s_bonus_amount, s_lives_at_level_start
    game = hash($6000, $623B) ^ hash($6256, $6472) ^ hash($6474, $6632) ^
           hash($6641, $69C1) ^ hash($69C3, $6B37) ^ hash($6B3D, $6C45) ^
           hash($6C4B, $6C70) ^ hash($6C72, $71CA) ^ hash($71CD, $7251) ^
           hash($7267, $78AF) ^ hash($78B3, $BFFF)) {
  printf("%08X %08X %08X %08X %08X %08X %08X %08X\n", zp_a, zp_b, zp_hi, low, txt, aux, hgr, game)
}

install kb at $FD1B, $741F, $7890, $6217, $760F, $FB7C, $FD26

# $760F as well as $6217. Both are keyboard reads, and between them they cover
# the two states the game has: $6217 is the in-game ingest, and $760F is the
# key-redefinition screen's read. Sampling only at $6217 meant the whole hi-res
# text and redefinition path went unsampled -- measured by shifting the glyph
# blitter's source by one row, which draws 205 wrong glyphs and was caught by
# nothing at all.
install mem at $6217, $760F
