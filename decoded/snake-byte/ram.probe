# Memory equivalence between the interpreter and a generated build, sampled at
# program-defined instants.
#
# The block-head trace (trace.probe) proves the two engines take the same path.
# This proves they compute the same values along it -- a wrong byte written to
# memory need not change control flow within a 1300-frame run, so the two
# checks are complementary rather than redundant.
#
# Sampled at $6217, the in-game keyboard ingest: reached 6,808 times and only
# while the game is playing, so the samples land where memory is churning. The
# obvious alternative -- sampling on the coordinate counter with `n % 512` --
# is badly biased: $7890 (the wait-for-space loop) is about two thirds of that
# counter's growth, so most samples would catch a static screen. Measured: 1079
# counter-sampled points yielded 26 distinct memory states, 6808 ingest-sampled
# points yielded 6808.
#
# THE STACK: live bytes are compared, dead ones are not.
#
# The live stack is everything above SP ($0101+SP..$01FF, since the 6502's SP
# points at the next free slot). It is compared, and it matches -- but only
# since decompile.sh started passing --ret-addr. Without that flag every JSR
# pushes the sentinel $FFFE instead of a return address, and this check found
# 27,232 differing live bytes across these same 6,808 samples, every one of
# them holding $FE or $FF on the generated side. With it: zero.
#
# Bytes *below* SP are dead -- popped, never read again -- and the two engines
# leave different residue there (13,700 differing bytes before --ret-addr, 2
# after). Hashing them would compare fill patterns, not behaviour.
#
# An empty stack (SP == $FF) has no live bytes at all, and `hash` needs a range
# that is not backwards, hence the branch.
#
# $C000-$CFFF is IO and holds no state worth comparing. Above that is ROM.
counter n

probe kb() {
  inc n
  key n
}

probe mem(
    s = sp,
    zp = hash($0000, $00FF),
    low = hash($0200, $03FF),
    txt = hash($0400, $07FF),
    aux = hash($0800, $1FFF),
    hgr = hash($2000, $5FFF),
    game = hash($6000, $BFFF)) {
  if (s == $FF) {
    printf("%02X empty %08X %08X %08X %08X %08X %08X\n", s, zp, low, txt, aux, hgr, game)
  } else {
    printf("%02X %08X %08X %08X %08X %08X %08X %08X\n",
           s, hash($0101 + s, $01FF), zp, low, txt, aux, hgr, game)
  }
}

install kb at $FD1B, $741F, $7890, $6217
install mem at $6217
